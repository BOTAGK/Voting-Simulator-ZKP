FROM rust:1.82-bookworm AS circom-builder

ARG CIRCOM_VERSION=v2.2.3

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --branch ${CIRCOM_VERSION} --depth 1 https://github.com/iden3/circom.git /tmp/circom
RUN cargo build --release --manifest-path /tmp/circom/circom/Cargo.toml

FROM node:22-bookworm-slim

ARG SNARKJS_VERSION=0.7.5

WORKDIR /workspace

RUN apt-get update \
    && apt-get install -y --no-install-recommends bash ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=circom-builder /tmp/circom/target/release/circom /usr/local/bin/circom

COPY package.json package-lock.json ./
RUN npm ci \
    && npm install -g snarkjs@${SNARKJS_VERSION}

COPY circuits ./circuits
COPY scripts/setup_zkp.sh ./scripts/setup_zkp.sh
RUN chmod +x ./scripts/setup_zkp.sh

CMD ["bash", "scripts/setup_zkp.sh"]
